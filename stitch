<?php

/**
 * Genera el código MVC del módulo y su directorio de recursos públicos.
 *
 * @param string $nombreCarpeta Nombre del módulo y de las clases que se generarán.
 * @return void Crea los archivos ausentes e imprime las rutas generadas en la terminal.
 */
function crearModulo(string $nombreCarpeta): void
{
    $estructura = ['Controllers', 'Models', 'Resources', 'Views'];
    $rutaBase = __DIR__ . DIRECTORY_SEPARATOR . 'Modules'; // Directorio de Modules
    $rutaPrincipal = $rutaBase . DIRECTORY_SEPARATOR . $nombreCarpeta;

    if (!is_dir($rutaPrincipal)) {
        mkdir($rutaPrincipal, 0755, true);
        echo "Carpeta principal creada: $rutaPrincipal\n";
    }

    foreach ($estructura as $subcarpeta) {
        $rutaSubcarpeta = $rutaPrincipal . DIRECTORY_SEPARATOR . $subcarpeta;
        if ($subcarpeta === 'Resources') {
            $rutaSubcarpeta = __DIR__ . DIRECTORY_SEPARATOR . 'public' . DIRECTORY_SEPARATOR . 'Modules'
                . DIRECTORY_SEPARATOR . $nombreCarpeta . DIRECTORY_SEPARATOR . 'Resources';
        }
        if (!is_dir($rutaSubcarpeta)) {
            mkdir($rutaSubcarpeta, 0755, true);
            echo "Subcarpeta creada: $rutaSubcarpeta\n";
        }

        // Crear archivo Controller con namespace y herencia
        if ($subcarpeta === 'Controllers') {
            $archivoController = $rutaSubcarpeta . DIRECTORY_SEPARATOR . $nombreCarpeta . 'Controller.php';
            if (!file_exists($archivoController)) {
                $contenidoController = <<<PHP
                <?php

                namespace Modules\\$nombreCarpeta\\Controllers;

                use App\\Controllers\\BaseController;

                /**
                 * Acciones HTTP del módulo {$nombreCarpeta}.
                 *
                 * @see BaseController Sesión, validación y renderizado heredados.
                 */
                class {$nombreCarpeta}Controller extends BaseController
                {
                    /**
                     * Prepara las dependencias del módulo después de iniciar la sesión.
                     *
                     * @return void Asigna los modelos o servicios propios del controlador.
                     */
                    protected function initialize(): void
                    {
                        // Inicializa aquí los modelos propios del módulo.
                    }

                    // Acciones del controlador.
                }
                PHP;
                file_put_contents($archivoController, $contenidoController);
                echo "Archivo creado: $archivoController\n";
            }
        }

        // Crear archivo Model con namespace y herencia
        if ($subcarpeta === 'Models') {
            $archivoModel = $rutaSubcarpeta . DIRECTORY_SEPARATOR . $nombreCarpeta . '.php';
            if (!file_exists($archivoModel)) {
                $contenidoModel = <<<PHP
                <?php

                namespace Modules\\$nombreCarpeta\\Models;

                use App\\Models\\BaseModel;

                /**
                 * Persistencia del módulo {$nombreCarpeta}.
                 *
                 * Configurar table, primaryKey y fillable antes de utilizar el CRUD.
                 *
                 * @see BaseModel Operaciones generales de persistencia heredadas.
                 */
                class {$nombreCarpeta} extends BaseModel
                {
                    // Propiedades y métodos del modelo
                }
                PHP;
                file_put_contents($archivoModel, $contenidoModel);
                echo "Archivo creado: $archivoModel\n";
            }
        }
    }

    echo "Módulo generado en Modules y recursos en public/Modules.\n";
}

// Ejecutar desde CLI
if (php_sapi_name() === 'cli') {
    if ($argc !== 2) {
        echo "Uso: php stitch [nombre_carpeta]\n";
        exit(1);
    }

    $nombreCarpeta = $argv[1];
    crearModulo($nombreCarpeta);
}
